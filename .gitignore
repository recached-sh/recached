# Generated by Cargo
# Contains compiled binaries and build artifacts
target/
debug/

# npm dependencies.
#
# There was no rule here, and only sdks/* carried their own — so
# `wasm-edge/node_modules` (all of TypeScript, 135 files) was committed by
# accident. Nothing in this repo vendors its dependencies.
node_modules/

# Wasm-pack generated output
# We ignore the pkg directory because it is automatically generated during the build
/wasm-edge/pkg/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor and IDE configurations
.vscode/
.idea/
*.iml
*.swp
*~

# Logs
*.log

# Note: Cargo.lock is intentionally NOT ignored.
# Because this project contains an executable (server-native),
# committing Cargo.lock is best practice to ensure reproducible builds!

PLAN.md
NOTES.md

# Local scratch scripts stay out, but the ones the README and the docs site link
# to have to be tracked or those links 404.
#
# `scripts/*` rather than `scripts/`: git cannot re-include a file whose parent
# directory is excluded, so a bare `scripts/` would make the negations below
# silently do nothing.
scripts/*
!scripts/bump-version.sh
!scripts/benchmark.sh
!scripts/bench-docker.sh
!scripts/bench-scaling.sh
!scripts/update-formula-checksums.sh
!scripts/update-deps.sh

# Cache snapshots / AOF written by a server started in the repo root
# (e.g. while running scripts/benchmark.sh). Never artifacts to commit.
*.rdb
*.aof
*.msgpack

# Benchmark output — scripts/bench-scaling.sh and scripts/benchmark.sh
bench-results/

# Cross-project comparison harness (Recached vs Redis vs Valkey).
#
# Kept out of the repo deliberately. Recached is currently slower per core
# than both, so shipping a ready-made comparison invites numbers that the
# project does not stand behind and has never published. Bring it back into
# scripts/ when the engine is competitive enough that the result is one we
# would put our name to.
bench-private/

brand

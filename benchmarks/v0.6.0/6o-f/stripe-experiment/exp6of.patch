+    pub(crate) static STRIPE_WAIT_NS: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static TX_CALLS: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static TX_STRIPES: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static TX_ALL: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static TX_LOCK_NS: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static GATE_CLOSES: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static GATE_DRAIN_NS: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static GATE_REFUSED: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static ALL_CALLS: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static ALL_NS: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static ALL_MAX_NS: AtomicU64 = AtomicU64::new(0);
+    pub(crate) fn add(c: &AtomicU64, n: u64) {
+        c.fetch_add(n, Relaxed);
+    }

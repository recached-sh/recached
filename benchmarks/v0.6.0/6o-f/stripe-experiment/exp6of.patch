+/// 6O-F3 EXPERIMENT ONLY: contention counters, read by `INFO exp6of`.
+/// Relaxed adds, and only on the contended or barrier paths, except for
+/// `STRIPE_TAKES` and `TX_*`, one add per lock call.
+pub(crate) mod exp6of {
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    pub(crate) const fn parse_or(v: Option<&str>, d: usize) -> usize {
+        match v {
+            None => d,
+            Some(s) => {
+                let b = s.as_bytes();
+                let mut i = 0;
+                let mut n = 0usize;
+                while i < b.len() {
+                    n = n * 10 + (b[i] - b'0') as usize;
+                    i += 1;
+                }
+                n
+            }
+        }
+    }

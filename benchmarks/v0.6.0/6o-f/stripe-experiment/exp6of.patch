+        let g = |c: &AtomicU64| c.load(Relaxed);
+        format!(
+            "exp6of_server_stripes:{}\r\nexp6of_store_stripes:{}\r\nstripe_calls:{}\r\nstripe_takes:{}\r\nstripe_contended:{}\r\nstripe_wait_ns:{}\r\ntx_calls:{}\r\ntx_stripes:{}\r\ntx_all:{}\r\ntx_lock_ns:{}\r\ngate_closes:{}\r\ngate_drain_ns:{}\r\ngate_refused:{}\r\nall_calls:{}\r\nall_ns:{}\r\nall_max_ns:{}\r\n",

+#[tokio::test(flavor = "multi_thread", worker_threads = 1)]
+#[ignore = "scratch trace (6N-C6 investigation)"]
+async fn c6_trace_r1() {
+    use crate::replication::c6trace;
+    let hub = hub(1 << 24);
+    let (addr, server, _senders) = serve(&hub, 4096).await;
+    let (replica, _, _) = attach(addr, 0).await;
+    wait_for("the replica to register", || hub.count.load(Ordering::Relaxed) == 1).await;
+    const WRITERS: usize = 40;
+    const PIPELINE: usize = 128;
+    const ROUNDS: usize = 8;
+    let acks = std::env::var("C6_NOACK").is_err();
+    let a2_hw: Option<usize> = std::env::var("C6_A2").ok().and_then(|v| v.parse().ok());
+    let total = WRITERS * PIPELINE * ROUNDS;
+    let reader = tokio::task::spawn_blocking(move || {
+        let rt = tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap();
+        rt.block_on(async move {
+            let (rd, mut wr) = replica.into_split();
+            let mut rd = tokio::io::BufReader::with_capacity(64 * 1024, rd);
+            let mut got = 0usize;
+            while got < total {
+                let mut h = [0u8; 12];
+                if rd.read_exact(&mut h).await.is_err() { return got; }
+                let len = u32::from_le_bytes(h[8..12].try_into().unwrap()) as usize;
+                let mut b = vec![0u8; len];
+                if rd.read_exact(&mut b).await.is_err() { return got; }
+                let last = u64::from_le_bytes(h[..8].try_into().unwrap());
+                got += 1;
+                if acks && rd.buffer().is_empty() {
+                    let _ = wr.write_all(&last.to_le_bytes()).await;
+                }
+            }
+            got
+        })
+    });
+    c6trace::ON.store(true, Ordering::Relaxed);
+    let writers: Vec<_> = (0..WRITERS)
+        .map(|w| {
+            let hub = Arc::clone(&hub);
+            tokio::spawn(async move {
+                for round in 0..ROUNDS {
+                    c6trace::ev(|| format!("W{w} r{round} start offset={}", hub.current_offset()));
+                    for i in 0..PIPELINE {
+                        hub.fan_out(tag(w, round * PIPELINE + i)).await;
+                        if let Some(hw) = a2_hw {
+                            if hub.max_queue_depth().await >= hw {
+                                c6trace::ev(|| format!("W{w} A2 yield at depth>={hw}"));
+                                tokio::task::yield_now().await;
+                            }
+                        }
+                    }
+                    tokio::task::yield_now().await;
+                }
+            })
+        })
+        .collect();
+    for writer in writers { writer.await.unwrap(); }
+    c6trace::ON.store(false, Ordering::Relaxed);
+    let got = reader.await.unwrap();
+    eprintln!("TRACE got={got} of {total} peak={} flushes={:?}", hub.send_queue_peak(), hub.send_stats());
+    for l in c6trace::LOG.lock().unwrap().iter() { eprintln!("{l}"); }
+    server.abort();
+}
